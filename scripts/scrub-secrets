#!/usr/bin/env bash
# Redact known secret VALUES from files at rest (transcripts, logs) WITHOUT ever
# printing a value. Reads values from a secrets file, finds files that contain
# them (filenames only), and replaces each with  <REDACTED:KEY>.
#
# Usage:
#   scrub-secrets <secrets-file> [--apply] [search-root ...]
#     Default is a DRY RUN: report which files contain each secret (count only).
#     --apply performs the in-place redaction (a one-time .bak-scrub backup is made).
#     Default search root: ~/.claude/projects
#
# A value never appears in stdout. grep uses -l (filenames only); sed runs without
# tracing. Run this only AFTER rotating the affected credentials — scrubbing a
# still-valid token is hygiene, not a fix.
#
# The secrets file is a simple KEY=value list (one per line; blanks and #-comments
# ignored). It is never written by this tool and should never be committed.
set -euo pipefail

secfile=${1:?usage: scrub-secrets <secrets-file> [--apply] [roots...]}
shift
apply=0
roots=()
while [[ $# -gt 0 ]]; do
	case "$1" in
		--apply) apply=1 ;;
		*) roots+=("$1") ;;
	esac
	shift
done
[[ ${#roots[@]} -eq 0 ]] && roots=("$HOME/.claude/projects")
[[ -f $secfile ]] || { echo "no secrets file: $secfile" >&2; exit 1; }

touched=0
while IFS= read -r kv || [[ -n $kv ]]; do
	[[ -z $kv || $kv == \#* || $kv != *=* ]] && continue
	key=${kv%%=*}
	val=${kv#*=}
	# strip surrounding quotes + whitespace
	val=${val%\"}; val=${val#\"}; val=${val%\'}; val=${val#\'}
	val=$(printf '%s' "$val" | tr -d '[:space:]')
	[[ ${#val} -lt 12 ]] && { echo "skip $key (value too short to be a secret)"; continue; }

	# filenames only — never print the value or the matching line
	mapfile -t hits < <(grep -rlF -- "$val" "${roots[@]}" 2>/dev/null || true)
	if [[ ${#hits[@]} -eq 0 ]]; then
		echo "clean: $key — 0 files"
		continue
	fi
	echo "FOUND: $key — ${#hits[@]} file(s)"
	printf '   %s\n' "${hits[@]}"
	if [[ $apply -eq 1 ]]; then
		# escape regex/delimiter metacharacters in the value for sed
		esc=$(printf '%s' "$val" | sed -e 's/[\/&|.[*^$]/\\&/g')
		for f in "${hits[@]}"; do
			sed -i.bak-scrub "s|${esc}|<REDACTED:${key}>|g" "$f"
			touched=$((touched + 1))
		done
	fi
done < "$secfile"

if [[ $apply -eq 1 ]]; then
	echo "scrub applied: $touched file(s) edited (.bak-scrub backups left)."
else
	echo "dry run — re-run with --apply to redact. (Rotate the credentials first.)"
fi
