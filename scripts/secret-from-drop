#!/usr/bin/env bash
# Pull a secret you dropped into a file on your workstation and store it on this
# dev box WITHOUT the value ever touching this terminal or the session
# transcript, then wipe both copies.
#
# Usage:
#   secret-from-drop <target-secrets-file>
#       Pull from the workstation's pinned drop file (a single line  KEY=value),
#       upsert KEY=value into <target-secrets-file>, print only the KEY name,
#       then shred the remote drop + the local temp.
#   secret-from-drop <target-secrets-file> --local <path>
#       Same, but read from a local file instead of the workstation (for testing).
#
# The value is never echoed, never in argv, never in stdout.
#
# adapt: configure your workstation drop via env vars (defaults are placeholders):
#   WORKSTATION_HOST       ssh host alias for your workstation (e.g. "workstation")
#   WORKSTATION_DROP_PATH  path to the drop file on the workstation
#                          (e.g. a temp dir: "<workstation-temp>/claude-secret-drop.txt")
# On a Windows workstation the drop is typically a Notepad file under C:/Temp/.
set -euo pipefail

target=${1:?usage: secret-from-drop <target-secrets-file> [--local <path>]}
shift
mode=remote
local_src=""
if [[ ${1:-} == --local ]]; then
	mode=local
	local_src=${2:?--local needs a path}
fi

# adapt: replace these placeholders (or export the env vars before running).
WORKSTATION_HOST="${WORKSTATION_HOST:-<workstation-host>}"
DROP_REMOTE="${WORKSTATION_DROP_PATH:-<workstation-temp>/claude-secret-drop.txt}"

tmp=$(mktemp)
cleanup() { shred -u "$tmp" 2>/dev/null || rm -f "$tmp"; }
trap cleanup EXIT

if [[ $mode == remote ]]; then
	if [[ "$WORKSTATION_HOST" == "<workstation-host>" ]]; then
		echo "set WORKSTATION_HOST (and WORKSTATION_DROP_PATH) or use --local <path>" >&2
		exit 1
	fi
	scp -q "${WORKSTATION_HOST}:${DROP_REMOTE}" "$tmp"
else
	cp "$local_src" "$tmp"
fi

# Normalize CRLF (Notepad), take the first non-empty line.
sed -i 's/\r$//' "$tmp"
line=$(grep -m1 . "$tmp" || true)
key=${line%%=*}
key=$(printf '%s' "$key" | tr -d '[:space:]')
if [[ ! $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || [[ "$line" != *=* ]]; then
	echo "drop malformed — expected one line  KEY=value" >&2
	exit 1
fi

# Upsert into the target without ever echoing the value.
umask 077
touch "$target"
out=$(mktemp)
cleanup() { shred -u "$tmp" "$out" 2>/dev/null || rm -f "$tmp" "$out"; }
grep -vE "^${key}=" "$target" 2>/dev/null > "$out" || true
grep -m1 "^${key}=" "$tmp" >> "$out"   # the KEY=value line; value not displayed
mv "$out" "$target"
chmod 600 "$target"

# Wipe the source drop so it isn't left lying around / backed up.
# adapt: the remote-wipe command below assumes a Windows workstation (PowerShell
# over SSH). Replace with the right command for your workstation OS, or just
# delete the drop file manually after running.
if [[ $mode == remote ]]; then
	ssh "$WORKSTATION_HOST" "powershell -c \"Remove-Item -Force '${DROP_REMOTE//\//\\}' -ErrorAction SilentlyContinue\"" 2>/dev/null \
		|| echo "(warn: could not wipe workstation drop — delete ${DROP_REMOTE} manually)" >&2
fi

echo "stored ${key} in ${target} ($(grep -cE '^[A-Za-z_]' "$target") keys); drops wiped."
