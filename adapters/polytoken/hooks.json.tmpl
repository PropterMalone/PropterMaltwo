[
  {
    "name": "proptermaltwo-gh-push-identity",
    "event": "pre_tool_use",
    "matcher": "shell_exec",
    "handler": {
      "bash": "python3 {{BRIDGE_PATH_SHELL_QUOTED}} --host polytoken --guard push"
    }
  },
  {
    "name": "proptermaltwo-gh-commit-author",
    "event": "pre_tool_use",
    "matcher": "shell_exec",
    "handler": {
      "bash": "python3 {{BRIDGE_PATH_SHELL_QUOTED}} --host polytoken --guard commit"
    }
  }
]
